# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Google AI Studio API key for Gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for agent responses / tool-calling.
GEMINI_MODEL=gemini-2.5-flash

# Local embedding model (sentence-transformers). Downloaded once, then cached locally.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Logging verbosity for the observability/debug trace (DEBUG, INFO, WARNING).
LOG_LEVEL=INFO

# Port for the local Flask API (Phase 19).
PORT=5000
